# QUIZZY / CodeArena Frontend Environment Template
# Copy this file to .env.local for local development.

# Backend API & WebSocket Gateway URLs (Required)
# Development: http://localhost:5000/api/v1 | Production: https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Development: http://localhost:5000 | Production: https://your-backend.onrender.com
NEXT_PUBLIC_WS_URL=http://localhost:5000

# Canonical Site URL (Optional, defaults to window.location.origin)
# Example: https://quizzyworld.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client Configuration (Google Cloud Console Web Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Custom Google OAuth Redirect URL (Optional; leave empty to use standard Google sign-in flow)
NEXT_PUBLIC_GOOGLE_AUTH_URL=

# Razorpay Payments Public Client Key (Required for AI Quiz Creator Pro Checkout modal)
# In development/test mode, use: rzp_test_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
