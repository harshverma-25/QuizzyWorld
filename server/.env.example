# Server Listening Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/codearena

# Native JWT & Guest Session Secret Keys (32+ chars required in production)
JWT_ACCESS_SECRET=your_native_access_jwt_secret_key_32_bytes_min
JWT_REFRESH_SECRET=your_native_refresh_jwt_secret_key_32_bytes_min
GUEST_JWT_SECRET=your_secure_guest_jwt_secret_key_32_bytes_min
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# CORS & WebSocket Allowed Origins (comma-separated list or wildcard in dev, e.g. https://quizzyworld.vercel.app)
CORS_ORIGIN=*

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Upstash Redis REST API (Optional caching layer; falls back to in-memory/MongoDB if omitted)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Redis Connection URI (Optional; for Socket.IO Redis adapter in multi-instance horizontal scaling)
REDIS_URI=redis://127.0.0.1:6379

# Google Gemini AI (Required for AI Quiz Generation endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare Workers AI (Optional; Text-to-Image Generation for Quizzes)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_AI_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# Cloudinary (Optional; Image Storage & CDN Optimization for Quiz Thumbnails)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Google OAuth Configuration (Optional; Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Razorpay Payments Configuration (Required for Pro plan subscriptions; test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
