{
  "name": "codearena-backend",
  "version": "1.0.0",
  "description": "CodeArena Backend Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed-questions.ts",
    "seed:catalog": "tsx src/scripts/seed-fresh-categories-subjects.ts",
    "seed:questions": "tsx src/scripts/seed-questions.ts",
    "clear:questions": "tsx src/scripts/clear-questions.ts",
    "test:security": "tsx src/scripts/verify-env-security.ts",
    "test:guest": "tsx src/scripts/verify-guest-auth.ts",
    "test:task2-1": "tsx src/scripts/verify-task2-1.ts",
    "test:native-auth": "tsx src/scripts/verify-native-auth.ts",
    "test:proxy-trust": "tsx src/scripts/verify-proxy-trust.ts",
    "reconcile:dry-run": "tsx src/scripts/reconcile-user-stats.ts",
    "reconcile:apply": "tsx src/scripts/reconcile-user-stats.ts --apply"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/redis": "^1.39.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "mongoose": "^8.5.1",
    "pino": "^9.3.2",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "pino-pretty": "^11.2.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "engine.io": "^6.6.10"
  }
}
